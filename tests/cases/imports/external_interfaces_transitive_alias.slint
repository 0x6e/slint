// Python is ignored because include paths aren't forwarded in the generated stubs.
//ignore: pyi

//include_path: ../../helper_components
import { ExportedInterface } from "export_interfaces.slint";
import { ExportedBaseViaAlias } from "export_interfaces_via_alias.slint";

// `ExportedBaseViaAlias` implements `ExportedInterface` under a local alias (see
// export_interfaces_via_alias.slint). This file refers to the interface by its canonical,
// unaliased name. The `uses` statement must still recognize that `base` implements it.
export component TestCase uses { ExportedInterface from base } {
    base := ExportedBaseViaAlias { }

    out property <bool> test: self.value == 2.71;
}

/*
```rust
let instance = TestCase::new().unwrap();
assert!(instance.get_test());
```

```cpp
auto handle = TestCase::create();
const TestCase &instance = *handle;
assert(instance.get_test());
```

```js
var instance = new slint.TestCase({});
assert(instance.test);
```
*/
